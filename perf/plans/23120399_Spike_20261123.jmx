<?xml version='1.0' encoding='UTF-8'?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="23120399_Spike_20261123" enabled="true">
      <stringProp name="TestPlan.comments">SPIKE (tăng đột ngột). Nhóm nền base_threads=50 VU (mức Load đã đo ở load2), ramp 30 s, chạy 420 s. Nhóm đỉnh spike_threads=500 VU vào ở giây spike_delay=120 trong spike_rampup=5 s, giữ spike_duration=60 s rồi dừng cùng lúc (giây 180). Cửa sổ đo: trước đỉnh 30-120 s, đỉnh 125-180 s, sau đỉnh 180-420 s (--bucket 10) để đo lỗi/p95 lúc đỉnh và thời gian hồi phục. Mỗi VU một tài khoản riêng (nhóm nền + đỉnh đọc chung users.csv, shareMode.all, không recycle), cần ≥ 550 tài khoản perf*. Đăng nhập một lần, think time 1-3 s (nhóm đỉnh có tham số riêng spike_think_min_ms/spike_think_range_ms), lockout-probe coi 401/403 là đúng (Equals + OR). Report: View Results Tree chỉ lỗi (Summary/Aggregate tắt). Ngưỡng phân tích như Stress: p95 500 ms, lỗi 5 %. Bản AI sinh ở P4, chưa review, chưa chạy.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="HOST" elementType="Argument">
            <stringProp name="Argument.name">HOST</stringProp>
            <stringProp name="Argument.value">${__P(host,localhost)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PORT" elementType="Argument">
            <stringProp name="Argument.name">PORT</stringProp>
            <stringProp name="Argument.value">${__P(port,3000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="DATA_DIR" elementType="Argument">
            <stringProp name="Argument.name">DATA_DIR</stringProp>
            <stringProp name="Argument.value">${__P(data_dir,../data)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
